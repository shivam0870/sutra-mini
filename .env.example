# Docker default. For native development change db to localhost.
# For Neon replace this with the dashboard connection string (sslmode=require).
DATABASE_URL=postgres://sutra:sutra@db:5432/sutra?sslmode=disable
TEST_DATABASE_URL=postgres://sutra:sutra@localhost:5432/sutra_test?sslmode=disable
API_ADDR=:8080
MOCK_ADDR=:8081
API_URL=http://localhost:8080
ACCOUNTING_URL=http://localhost:8081/api/vouchers
MOCK_MODE=random
WORKER_CONCURRENCY=4
WORKER_MAX_ATTEMPTS=5
WORKER_HTTP_TIMEOUT=1s
WORKER_LEASE_DURATION=10s
WORKER_POLL_INTERVAL=250ms
WORKER_BASE_BACKOFF=1s
WORKER_MAX_BACKOFF=30s
